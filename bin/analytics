#!/bin/sh
# analytics — human CLI for Aelix Analytics projects (the same kit the aelix extension drives).
#
#   analytics init DIR [--title T] [--goal G]   create a project and its uv environment
#   analytics demo DIR                          new project with synthetic data and example runs
#   analytics status | context                  overview | the context block agents receive
#   analytics run SCRIPT --title T [--input P] [--timeout S]
#   analytics run --rerun-of RUN_ID --title T   re-execute a run's code snapshot and compare
#   analytics import FILE [--name N] [--description D]
#   analytics query "SQL" [--limit N]
#   analytics record KIND "TEXT" [--ref R] [--resolves eN]
#   analytics render | open                     rebuild | open the Workspace page
#
# Commands other than init/demo use the project in AELIX_ANALYTICS_PROJECT, else the nearest directory
# at or above the current one with an analytics.json or a lab.json; the kit judges it.
# Output ends with one JSON line (status and context print text); a run that got past its setup
# puts an empty line before it. Nothing here is a sandbox.
set -eu

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
PACK=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd -P)
UV=${AELIX_ANALYTICS_UV:-uv}
unset VIRTUAL_ENV
# AELIX_ANALYTICS_ACTOR goes on as the caller set it, and only then: without it the kit records
# `human` as inferred, not declared (the installed command's child_env is the same).
export PYTHONPATH="$PACK/src" MPLBACKEND=Agg PYTHONDONTWRITEBYTECODE=1

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$self"; }

# The environment variables this command read under the kit's old names (before kit 0.3.0): an error
# that names the new one, not an alias. The same three, order and words as the installed command's
# OLD_ENV (src/aelix_analytics/cli.py); the kit refuses the others it read.
refuse_renamed() {
  for pair in LAB_PROJECT=AELIX_ANALYTICS_PROJECT LAB_ACTOR=AELIX_ANALYTICS_ACTOR AELIX_LAB_UV=AELIX_ANALYTICS_UV; do
    old=${pair%%=*} new=${pair#*=}
    eval "value=\${$old:-}"
    if [ -n "$value" ]; then
      note=
      [ "$new" = AELIX_ANALYTICS_PROJECT ] && note=" (the analytics command and the aelix extension both read AELIX_ANALYTICS_PROJECT, ahead of the working directory)"
      echo "analytics: $old was renamed $new in kit 0.3.0$note; set $new instead and unset $old" >&2
      exit 2
    fi
  done
}

# An entry of a marker's name that is not a directory: a file, a FIFO, a socket, a link that leads
# nowhere or loops (the kit judges it; the installed command's has_marker is the same rule).
has_marker() { { [ -e "$1" ] || [ -L "$1" ]; } && [ ! -d "$1" ]; }

# A marker as the kit counts one (the installed command's kit_marker): an entry that is not a
# directory, where a link that leads nowhere is none and one that loops is one. A link stat cannot
# follow is followed here link by link, and counts if it is still a link after 32 of them: the
# smaller of macOS's and Linux's limits (32, 40), so a chain the kit counts is never passed over.
kit_marker() {
  if [ -e "$1" ]; then [ ! -d "$1" ]; return; fi
  km_path=$1 km_n=0
  while [ -L "$km_path" ] && [ "$km_n" -lt 32 ]; do
    km_to=$(readlink "$km_path")
    case $km_to in /*) km_path=$km_to ;; *) km_path=$(dirname "$km_path")/$km_to ;; esac
    km_n=$((km_n + 1))
  done
  [ -e "$km_path" ] || [ -L "$km_path" ]
}

# The directory the kit takes for the project from where find_project stopped, upward (the installed
# command's kit_root): `open` opens its page. The start itself when none above has a marker.
kit_root() {
  kr_dir=$1
  while :; do
    if kit_marker "$kr_dir/analytics.json" || kit_marker "$kr_dir/lab.json"; then printf '%s\n' "$kr_dir"; return 0; fi
    [ "$kr_dir" = / ] && break
    kr_dir=$(dirname "$kr_dir")
  done
  printf '%s\n' "$1"
}

find_project() {
  if [ -n "${AELIX_ANALYTICS_PROJECT:-}" ]; then printf '%s\n' "$AELIX_ANALYTICS_PROJECT"; return 0; fi
  dir=$(pwd -P)
  while :; do
    if has_marker "$dir/analytics.json" || has_marker "$dir/lab.json"; then printf '%s\n' "$dir"; return 0; fi
    [ "$dir" = / ] && break
    dir=$(dirname "$dir")
  done
  echo "analytics: no analytics.json or lab.json in $(pwd -P) or its parents (cd into a project or set AELIX_ANALYTICS_PROJECT)" >&2
  return 1
}

kit() {  # kit PROJECT ARGS...
  proj=$1; shift
  "$UV" run --project "$proj" --quiet python -m aelix_analytics --project "$proj" "$@"
}

cmd=${1:-status}
[ $# -gt 0 ] && shift

case $cmd in
  -h|--help|help) usage ;;
  init|demo)
    [ $# -ge 1 ] || { echo "usage: analytics $cmd DIR" >&2; exit 2; }
    refuse_renamed
    dir=$1; shift
    "$UV" run --no-project --python 3.12 --quiet python -m aelix_analytics init "$dir" "$@"
    proj=$(CDPATH='' cd -- "$dir" && pwd -P)
    echo "analytics: syncing the project environment (first time can take a minute) ..." >&2
    "$UV" sync --project "$proj" --quiet || "$UV" sync --project "$proj" --quiet --offline
    if [ "$cmd" = demo ]; then
      kit "$proj" demo
    else
      kit "$proj" render >/dev/null
    fi
    echo "analytics: Workspace at $proj/workspace/index.html (analytics open, from inside the project)" >&2
    ;;
  status|context)
    refuse_renamed
    proj=$(find_project)
    kit "$proj" --text "$cmd"
    ;;
  open)
    refuse_renamed
    proj=$(find_project)
    [ -n "${AELIX_ANALYTICS_PROJECT:-}" ] || proj=$(kit_root "$proj")
    if kit_marker "$proj/analytics.json" && kit_marker "$proj/lab.json"; then
      echo "analytics: $proj holds two project markers, analytics.json and lab.json, and the kit reads neither; analytics status says more" >&2
      exit 1
    fi
    # The page of the project's layout, by its marker's name (the installed command's open): a
    # lab.json project's report/ is opened when it is there, and never built or updated.
    if kit_marker "$proj/analytics.json"; then index=$proj/workspace/index.html; else index=$proj/report/index.html; fi
    if [ "$index" = "$proj/report/index.html" ] && [ -f "$index" ]; then
      echo "analytics: $proj uses the older record format (lab.json): the kit reads it and no longer updates this page; analytics status says how to migrate it" >&2
    fi
    [ -f "$index" ] || kit "$proj" render >/dev/null
    if command -v open >/dev/null 2>&1; then open "$index"
    else xdg-open "$index"; fi
    ;;
  run|import|query|record|render)
    refuse_renamed
    proj=$(find_project)
    kit "$proj" "$cmd" "$@"
    ;;
  *) usage >&2; exit 2 ;;
esac
